# Model Autopsy Backend Environment Variables
# Copy this file to .env and customize

# Application
APP_NAME="Model Autopsy API"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/model_autopsy
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# CORS
CORS_ORIGINS=http://localhost:3000

# ML Engine Paths (relative to backend directory)
ML_ENGINE_PATH=../ml_engine
ARTIFACTS_BASE_DIR=../artifacts/experiments
CONFIGS_BASE_DIR=../configs/experiments
SCRIPTS_BASE_DIR=../scripts/experiments

# Experiment Execution
MAX_CONCURRENT_EXPERIMENTS=2
EXPERIMENT_TIMEOUT_SECONDS=3600
DEFAULT_SEEDS=[42, 123, 456, 789, 1011]

# Security (optional)
# API_KEY=your-secret-api-key